def conf():
    if not CONF.exists():
        CONF_DIR.mkdir(parents=True, exist_ok=True)
        CONF.write_text(DEFAULT_CONF)
    with CONF.open("rb") as f:
        return tomllib.load(f)


ANIM_MODES = ("off", "30s", "always")
ALL_TABS = ["notifications", "agenda", "home", "photos", "weather", "pc", "display"]
HM = re.compile(r"^([01]\d|2[0-3]):[0-5]\d$")


def write_conf(c):
    """Rewrites config.toml from the parsed dict (same layout as DEFAULT_CONF)."""
    q = json.dumps
    s, sl = c.get("screen", {}), c.get("slideshow", {})
    lines = [
        "# Phone: Tailscale (MagicDNS) name or IP address",
        f"phone = {q(c.get('phone', 'galaxy-a53-5g'))}",
        f"port = {int(c.get('port', 8765))}",
        f"language = {q(c.get('language', 'it'))}   # dashboard UI: \"it\" or \"en\"",
        "",
        "# Brightness % per time slot: each value holds until the next one",
        "[brightness]",
        *[f"{q(k)} = {int(v)}" for k, v in sorted(c.get("brightness", {}).items())],
        "",
        "[screen]",
        f"night = {q(s.get('night', []))}   # dimmed clock only",
        f"off = {q(s.get('off', []))}   # black screen (tap = on for 30 s)",
        f"pc_offline_after = {int(s.get('pc_offline_after', 90))}     # seconds without heartbeat => PC considered off",
        f"on_lock = {q(s.get('on_lock', 'frame'))}         # PC locked: \"frame\", \"off\", \"none\"",
        f"light_sensor = {'true' if s.get('light_sensor', True) else 'false'}       # scale brightness with the light sensor",
        "",
        "[slideshow]",
        f"folders = {q(sl.get('folders', ['~/Pictures/my_wallpapers']))}",
        f"seconds = {int(sl.get('seconds', 20))}",
        f"max_size = {int(sl.get('max_size', 2400))}           # long side (px) of the photos sent to the phone",
        "",
        "# Billable Hours: Google Sheets backup web app (same URL and secret word as the watchapp)",
        "[billable]",
        f"url = {q(c.get('billable', {}).get('url', ''))}",
        f"token = {q(c.get('billable', {}).get('token', ''))}",
        "",
        "[player]",
        f"animation = {q(c.get('player', {}).get('animation', '30s'))}         # wave and cover: \"off\", \"30s\", \"always\"",
        f"lyrics = {'true' if c.get('player', {}).get('lyrics', True) else 'false'}             # synced lyrics in the photo frame",
        "",
        "[notes]",
        f"items = {q(c.get('notes', {}).get('items', []))}",
        "",
        "# \"Screen\" tab: one niri output streamed to the phone over USB (adb), touches go back as a touchscreen",
        "[mirror]",
        f"output = {q(c.get('mirror', {}).get('output', 'DP-1'))}        # niri output name (niri msg outputs), e.g. a dummy plug",
        f"port = {int(c.get('mirror', {}).get('port', 8767))}",
        f"bitrate = {int(c.get('mirror', {}).get('bitrate', 8000))}         # kbit/s (H.264, NVENC)",
        f"fps = {int(c.get('mirror', {}).get('fps', 30))}",
        "",
        "[layout]",
        f"tabs = {q(c.get('layout', {}).get('tabs', ALL_TABS))}   # order; remove an entry to hide that tab",
        f"show_billable = {'true' if c.get('layout', {}).get('show_billable', True) else 'false'}",
        f"show_notes = {'true' if c.get('layout', {}).get('show_notes', True) else 'false'}",
        "",
    ]
    tmp = CONF.with_suffix(".tmp")
    tmp.write_text("\n".join(lines))
    tmp.replace(CONF)


def set_schedule(c, raw):
    d = json.loads(raw)
    bright = {}
    for t, v in d.get("brightness", []):
        if not HM.match(t) or not 0 <= int(v) <= 100:
            sys.exit(f"Invalid brightness slot: {t} = {v}")
        bright[t] = int(v)
    if not bright:
        sys.exit("At least one brightness slot is required")
    ranges = {}
    for key in ("night", "off"):
        out = []
        for r in d.get(key, []):
            a, _, b = r.partition("-")
            if not (HM.match(a) and HM.match(b)):
                sys.exit(f"Invalid range: {r}")
            out.append(f"{a}-{b}")
        ranges[key] = out
    c["brightness"] = bright
    c.setdefault("screen", {}).update(ranges)
    write_conf(c)
    try:  # push right away instead of waiting for the service tick
        req(c, "POST", "/state", state_payload(c))
    except Exception:
        pass
    print("ok")


def push(c):
    try:
        req(c, "POST", "/state", state_payload(c))
    except Exception:
        pass


def token():
    if not TOKEN.exists():
        sys.exit("No token: connect the phone over USB and run `phonedash pair`.")
    return TOKEN.read_text().strip()


def req(c, method, path, body=None, ctype="application/json", timeout=10):
    url = f"http://{c.get('phone', 'a53')}:{c.get('port', 8765)}{path}"
    data = json.dumps(body).encode() if isinstance(body, (dict, list)) else body
    r = urllib.request.Request(url, data=data, method=method,
                               headers={"Authorization": f"Bearer {token()}", "Content-Type": ctype})
    with urllib.request.urlopen(r, timeout=timeout) as resp:
        return json.loads(resp.read() or b"{}")


def state_payload(c):
    s, sl = c.get("screen", {}), c.get("slideshow", {})
    payload = {"config": {
        "brightness": [[k, int(v)] for k, v in c.get("brightness", {}).items()],
        "night": s.get("night", []),
        "screen_off": s.get("off", []),
        "pc_offline_after": int(s.get("pc_offline_after", 90)),
        "slideshow_seconds": int(sl.get("seconds", 20)),
        "billable_url": c.get("billable", {}).get("url", ""),
        "billable_token": c.get("billable", {}).get("token", ""),
        "player_animation": c.get("player", {}).get("animation", "30s"),
        "lyrics": bool(c.get("player", {}).get("lyrics", True)),
        "light_sensor": bool(s.get("light_sensor", True)),
        "on_lock": s.get("on_lock", "frame"),
        "language": c.get("language", "it"),
        "tabs": c.get("layout", {}).get("tabs", list(ALL_TABS)),
        "show_billable": bool(c.get("layout", {}).get("show_billable", True)),
        "show_notes": bool(c.get("layout", {}).get("show_notes", True)),
    }}
    payload["notifications"] = recent_notifications()
    payload["notes"] = [str(n)[:200] for n in c.get("notes", {}).get("items", [])][:6]
    payload["pc_locked"] = pc_locked()
    payload["pc_stats"] = pc_stats()
    try:
        payload["colors"] = json.loads(COLORS.read_text())["colors"]["dark"]
    except (OSError, KeyError, ValueError):
        pass
    return payload


NOTIF = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "dms" / "notification_history.json"
TAG = re.compile(r"<[^>]+>")


def recent_notifications(limit=20, max_age_h=24):
    """Last DMS notifications (newest first), plain text, trimmed."""
    try:
        items = json.loads(NOTIF.read_text()).get("notifications", [])
    except (OSError, ValueError):
        return []
    cutoff = (time.time() - max_age_h * 3600) * 1000
    out = []
    for n in items:
        ts = int(n.get("timestamp", 0))
        if ts < cutoff:
            continue
        out.append({"app": n.get("appName", "")[:40], "summary": TAG.sub("", n.get("summary", ""))[:120],
                    "body": TAG.sub("", n.get("body", ""))[:300], "ts": ts})
    out.sort(key=lambda n: -n["ts"])
    return out[:limit]


def pc_locked():
    """DMS lock screen state (falls back to logind's LockedHint)."""
    try:
        out = subprocess.run(["dms", "ipc", "call", "lock", "isLocked"], capture_output=True, text=True, timeout=3)
        if out.returncode == 0 and out.stdout.strip() in ("true", "false"):
            return out.stdout.strip() == "true"
    except (OSError, subprocess.TimeoutExpired):
        pass
    sid = os.environ.get("XDG_SESSION_ID", "")
    if sid:
        out = subprocess.run(["loginctl", "show-session", sid, "-p", "LockedHint", "--value"], capture_output=True, text=True)
        return out.stdout.strip() == "yes"
    return False


_cpu_prev = None


def _hwmon_temp(name):
    for h in Path("/sys/class/hwmon").glob("hwmon*"):
        try:
            if (h / "name").read_text().strip() == name:
                return round(int((h / "temp1_input").read_text()) / 1000)
        except (OSError, ValueError):
            pass
    return None


def pc_stats():
    """CPU % since the previous call, RAM, temperatures. Cheap: a few /proc and /sys reads."""
    global _cpu_prev
    vals = [int(v) for v in Path("/proc/stat").read_text().split("\n", 1)[0].split()[1:]]
    idle, total = vals[3] + vals[4], sum(vals)
    cpu = None
    if _cpu_prev:
        dt, di = total - _cpu_prev[1], idle - _cpu_prev[0]
        cpu = round(100 * (dt - di) / dt) if dt else 0
    _cpu_prev = (idle, total)
    mem = {l.split(":")[0]: int(l.split()[1]) for l in Path("/proc/meminfo").read_text().splitlines()[:5]}
    used = mem["MemTotal"] - mem["MemAvailable"]
    return {"cpu": cpu, "ram": round(100 * used / mem["MemTotal"]),
            "ram_used": round(used / 1048576, 1), "ram_total": round(mem["MemTotal"] / 1048576, 1),
            "cpu_temp": _hwmon_temp("coretemp"), "disk_temp": _hwmon_temp("nvme"),
            "load": round(os.getloadavg()[0], 2)}


def local_photos(c):
    out = {}
    max_size = int(c.get("slideshow", {}).get("max_size", 2400))
    for folder in c.get("slideshow", {}).get("folders", []):
        for p in sorted(Path(folder).expanduser().rglob("*")):
            if p.suffix.lower() in IMG_EXT and p.is_file():
                key = f"{p}|{p.stat().st_mtime_ns}|{max_size}".encode()
                out[hashlib.sha1(key).hexdigest()[:20] + ".jpg"] = p
    return out


def encode_photo(path, max_size):
    from PIL import Image, ImageOps
    with Image.open(path) as im:
        im = ImageOps.exif_transpose(im).convert("RGB")
        im.thumbnail((max_size, max_size))
        buf = io.BytesIO()
        im.save(buf, "JPEG", quality=85, optimize=True)
        return buf.getvalue()


def sync_photos(c, verbose=False):
    wanted = local_photos(c)
    remote = set(req(c, "GET", "/photos").get("photos", []))
    max_size = int(c.get("slideshow", {}).get("max_size", 2400))
    missing = [n for n in wanted if n not in remote]
    for i, name in enumerate(missing, 1):
        try:
            req(c, "PUT", f"/photos/{name}", encode_photo(wanted[name], max_size), "image/jpeg", timeout=60)
            if verbose:
                print(f"\r{i}/{len(missing)} photos sent", end="", flush=True)
        except Exception as e:  # skip unreadable images
            print(f"\n{wanted[name]}: {e}", file=sys.stderr)
    for name in remote - wanted.keys():
        req(c, "DELETE", f"/photos/{name}")
    if verbose:
        print(f"\nPhotos: {len(wanted)} on the PC, {len(missing)} sent, {len(remote - wanted.keys())} removed.")


# ---- Pull server for other phones (sidecar_launcher): photos + palette ------------------------------
LAUNCHER_PKG = "dev.vq.sidecarlauncher"
LAUNCHER_TOKEN = CONF_DIR / "launcher_token"
PULL_PORT = 8766
PULL_CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "phone-dash" / "pull"


def launcher_token():
    if not LAUNCHER_TOKEN.exists():
        CONF_DIR.mkdir(parents=True, exist_ok=True)
        LAUNCHER_TOKEN.write_text(os.urandom(24).hex() + "\n")
        LAUNCHER_TOKEN.chmod(0o600)
    return LAUNCHER_TOKEN.read_text().strip()


def serve_pull():
    """GET /photos, GET /photos/<name>?max=N (resized JPEG, cached), GET /colors — bearer token."""
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import urlparse, parse_qs
    tok = launcher_token()

    class H(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def send(self, code, body, ctype="application/json"):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            if self.headers.get("Authorization") != f"Bearer {tok}":
                return self.send(401, b'{"error":"unauthorized"}')
            u = urlparse(self.path)
            c = conf()
            if u.path == "/colors":
                try:
                    return self.send(200, json.dumps({"colors": {"dark": json.loads(COLORS.read_text())["colors"]["dark"]}}).encode())
                except (OSError, KeyError, ValueError):
                    return self.send(404, b"{}")
            if u.path == "/photos":
                return self.send(200, json.dumps({"photos": sorted(local_photos(c))}).encode())
            if u.path.startswith("/photos/"):
                name = u.path.rsplit("/", 1)[-1]
                src = local_photos(c).get(name)
                if not src:
                    return self.send(404, b"{}")
                size = max(320, min(4000, int(parse_qs(u.query).get("max", ["1440"])[0])))
                cached = PULL_CACHE / f"{size}-{name}"
                if not cached.exists():
                    PULL_CACHE.mkdir(parents=True, exist_ok=True)
                    cached.write_bytes(encode_photo(src, size))
                return self.send(200, cached.read_bytes(), "image/jpeg")
            self.send(404, b"{}")

    ThreadingHTTPServer(("0.0.0.0", PULL_PORT), H).serve_forever()


def pair_launcher():
    """Writes {host, port, token} into the launcher's files dir over adb (any connected phone that has it)."""
    host = os.uname().nodename
    try:
        st = json.loads(subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True).stdout)
        host = ",".join([st["Self"]["DNSName"].rstrip(".")] + st["Self"].get("TailscaleIPs", [])[:1]) or host
    except Exception:
        pass
    hosts = host.split(",")
    try:  # LAN addresses as fallbacks (phone at home without Tailscale)
        out = subprocess.run(["ip", "-4", "-o", "addr", "show", "scope", "global"], capture_output=True, text=True).stdout
        hosts += [l.split()[3].split("/")[0] for l in out.splitlines() if "tailscale" not in l]
    except OSError:
        pass
    host = ",".join(dict.fromkeys(hosts))
    b = conf().get("billable", {})
    data = json.dumps({"host": host, "port": PULL_PORT, "token": launcher_token(),
                       "billable_url": b.get("url", ""), "billable_token": b.get("token", "")})
    serials = [l.split()[0] for l in subprocess.run(["adb", "devices"], capture_output=True, text=True).stdout.splitlines()[1:] if l.endswith("device")]
    done = 0
    for sn in serials:
        if LAUNCHER_PKG not in subprocess.run(["adb", "-s", sn, "shell", "pm", "list", "packages", LAUNCHER_PKG], capture_output=True, text=True).stdout:
            continue
        # Passed as an intent extra (the app can't read files adb creates in its dir); the app only
        # accepts it from the shell uid.
        import base64
        b64 = base64.b64encode(data.encode()).decode()
        subprocess.run(["adb", "-s", sn, "shell", "am", "start", "-n", f"{LAUNCHER_PKG}/.MainActivity", "--es", "pc_pair_b64", b64],
                       capture_output=True, check=True)
        print(f"{sn}: launcher paired with {host}:{PULL_PORT}")
        done += 1
    if not done:
        sys.exit("No connected phone has the launcher installed.")


# ---- Mirror: one niri output on the phone ("display" tab) -------------------------------------------
# niri implements the org.gnome.Mutter.ScreenCast D-Bus API: RecordMonitor(output) gives a PipeWire stream,
# GStreamer imports its DMA-BUFs through GL and encodes H.264 with NVENC. The phone connects through
# `adb reverse` (USB: no Wi-Fi needed, nothing listens on the network) and authenticates with its API token.
# Frames to the phone: 1-byte type + 4-byte big-endian length + payload (1 = JSON size, 2 = H.264 access unit).
# From the phone: JSON lines (touches with normalised coordinates, keyframe requests).

def mirror_conf(c):
    m = c.get("mirror", {})
    return str(m.get("output", "DP-1")), int(m.get("port", 8767)), int(m.get("bitrate", 8000)), int(m.get("fps", 30))


def mirror_stream(output, bitrate, fps):
    """Child process: streams [output] as framed H.264 on stdout; "key" on stdin forces a keyframe; EOF stops."""
    import struct
    import gi
    gi.require_version("Gst", "1.0")
    gi.require_version("GstVideo", "1.0")
    from gi.repository import Gio, GLib, Gst, GstVideo
    Gst.init(None)
    out = sys.stdout.buffer
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)

    def call(path, iface, method, args, rtype):
        return bus.call_sync("org.gnome.Mutter.ScreenCast", path, iface, method, args,
                             GLib.VariantType(rtype) if rtype else None, 0, -1, None)

    sess = call("/org/gnome/Mutter/ScreenCast", "org.gnome.Mutter.ScreenCast", "CreateSession",
                GLib.Variant("(a{sv})", ({},)), "(o)").unpack()[0]
    stream = call(sess, "org.gnome.Mutter.ScreenCast.Session", "RecordMonitor",
                  GLib.Variant("(sa{sv})", (output, {"cursor-mode": GLib.Variant("u", 1)})), "(o)").unpack()[0]
    loop = GLib.MainLoop()
    st = {"pipe": None, "size": None}

    def send(kind, payload):
        out.write(struct.pack(">BI", kind, len(payload)) + payload)
        out.flush()

    def on_sample(sink):
        sample = sink.emit("pull-sample")
        s0 = sample.get_caps().get_structure(0)
        size = (s0.get_value("width"), s0.get_value("height"))
        if size != st["size"]:
            st["size"] = size
            send(1, json.dumps({"w": size[0], "h": size[1]}).encode())
        buf = sample.get_buffer()
        ok, info = buf.map(Gst.MapFlags.READ)
        if ok:
            try:
                send(2, bytes(info.data))
            except (BrokenPipeError, OSError):
                loop.quit()
            finally:
                buf.unmap(info)
        return Gst.FlowReturn.OK

    def on_added(_c, _s, _p, _i, _sig, params):
        node = params.unpack()[0]
        # keepalive-time: the last frame is repeated every second on a still screen (late joiners get a picture).
        p = Gst.parse_launch(
            f"pipewiresrc path={node} do-timestamp=true keepalive-time=1000 ! glupload ! glcolorconvert ! "
            f"video/x-raw(memory:GLMemory),format=NV12 ! gldownload ! "
            f"nvh264enc name=enc preset=low-latency-hq zerolatency=true gop-size={fps * 2} rc-mode=cbr bitrate={bitrate} "
            f"repeat-sequence-header=true ! h264parse config-interval=-1 ! "
            f"video/x-h264,stream-format=byte-stream,alignment=au,profile=high ! "
            f"appsink name=sink emit-signals=true sync=false max-buffers=0 drop=false")
        p.get_by_name("sink").connect("new-sample", on_sample)
        # At most [fps] frames into the encoder (niri casts at the monitor's refresh, up to 180 Hz here).
        gap, last = 1.0 / max(1, fps), [0.0]

        def limit(_pad, _info):
            now = time.monotonic()
            if now - last[0] < gap * 0.9:
                return Gst.PadProbeReturn.DROP
            last[0] = now
            return Gst.PadProbeReturn.OK
        p.get_by_name("enc").get_static_pad("sink").add_probe(Gst.PadProbeType.BUFFER, limit)
        pbus = p.get_bus()
        pbus.add_signal_watch()
        pbus.connect("message::error", lambda _b, m: (print(f"mirror: {m.parse_error()[0].message}", file=sys.stderr, flush=True), loop.quit()))
        p.set_state(Gst.State.PLAYING)
        st["pipe"] = p

    def on_stdin(ch, _cond):
        line = ch.readline()
        if not line:
            loop.quit(); return False
        if line.strip() == "key":
            # Before the pipeline exists the first frame is a keyframe anyway; afterwards ask the encoder.
            if st["pipe"]:
                st["pipe"].get_by_name("enc").get_static_pad("src").send_event(
                    GstVideo.video_event_new_upstream_force_key_unit(Gst.CLOCK_TIME_NONE, True, 0))
        return True

    bus.signal_subscribe(None, "org.gnome.Mutter.ScreenCast.Stream", "PipeWireStreamAdded", stream, None, 0, on_added)
    GLib.io_add_watch(GLib.IOChannel.unix_new(sys.stdin.fileno()), GLib.PRIORITY_DEFAULT, GLib.IOCondition.IN | GLib.IOCondition.HUP, on_stdin)
    call(sess, "org.gnome.Mutter.ScreenCast.Session", "Start", None, None)
    try:
        loop.run()
    finally:
        if st["pipe"]:
            st["pipe"].set_state(Gst.State.NULL)
        try:
            call(sess, "org.gnome.Mutter.ScreenCast.Session", "Stop", None, None)
        except Exception:
            pass


class Touchscreen:
    """Virtual multitouch screen (uinput). niri maps it to the mirrored output with
    input { touch { map-to-output "OUTPUT" } }; touches never move the mouse pointer."""
    MAX = 32767

    def __init__(self):
        from evdev import UInput, AbsInfo, ecodes as e
        self.e = e
        ax = AbsInfo(0, 0, self.MAX, 0, 0, 100)
        self.dev = UInput({e.EV_KEY: [e.BTN_TOUCH], e.EV_ABS: [
            (e.ABS_X, ax), (e.ABS_Y, ax), (e.ABS_MT_SLOT, AbsInfo(0, 0, 9, 0, 0, 0)),
            (e.ABS_MT_TRACKING_ID, AbsInfo(0, 0, 65535, 0, 0, 0)), (e.ABS_MT_POSITION_X, ax), (e.ABS_MT_POSITION_Y, ax)]},
            name="phonedash touch", input_props=[e.INPUT_PROP_DIRECT])
        self.slots, self.next_id = {}, 1

    def event(self, kind, pid, x, y):
        e, w = self.e, self.dev.write
        if kind == "d" and pid not in self.slots:
            free = next((s for s in range(10) if s not in self.slots.values()), None)
            if free is None:
                return
            self.slots[pid] = free
            w(e.EV_ABS, e.ABS_MT_SLOT, free)
            w(e.EV_ABS, e.ABS_MT_TRACKING_ID, self.next_id)
            self.next_id = self.next_id % 65000 + 1
        slot = self.slots.get(pid)
        if slot is None:
            return
        w(e.EV_ABS, e.ABS_MT_SLOT, slot)
        if kind == "u":
            w(e.EV_ABS, e.ABS_MT_TRACKING_ID, -1)
            del self.slots[pid]
        else:
            px, py = int(min(max(x, 0.0), 1.0) * self.MAX), int(min(max(y, 0.0), 1.0) * self.MAX)
            w(e.EV_ABS, e.ABS_MT_POSITION_X, px); w(e.EV_ABS, e.ABS_MT_POSITION_Y, py)
            w(e.EV_ABS, e.ABS_X, px); w(e.EV_ABS, e.ABS_Y, py)
        w(e.EV_KEY, e.BTN_TOUCH, 1 if self.slots else 0)
        self.dev.syn()

    def release_all(self):
        for pid in list(self.slots):
            self.event("u", pid, 0, 0)


def serve_mirror():
    """127.0.0.1:<port>, reached by the phone through `adb reverse`. One session at a time."""
    import hmac, socket
    _o, port, _b, _f = mirror_conf(conf())
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(("127.0.0.1", port))
    srv.listen(2)
    touch = [None]
    current = [None]

    def session(conn):
        child = None
        try:
            conn.settimeout(5)
            f = conn.makefile("rb")
            hello = json.loads(f.readline() or b"{}")
            if not hmac.compare_digest(str(hello.get("token", "")), token()):
                return
            conn.settimeout(None)
            conn.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            output, _p, bitrate, fps = mirror_conf(conf())
            child = subprocess.Popen([sys.executable, os.path.realpath(__file__), "_mirror-stream", output, str(bitrate), str(fps)],
                                     stdin=subprocess.PIPE, stdout=subprocess.PIPE)

            def pump():
                try:
                    while chunk := child.stdout.read1(65536):
                        conn.sendall(chunk)
                except OSError:
                    pass
                try:
                    conn.shutdown(socket.SHUT_RDWR)
                except OSError:
                    pass
            threading.Thread(target=pump, daemon=True).start()
            if touch[0] is None:
                try:
                    touch[0] = Touchscreen()
                except Exception as e:
                    print(f"mirror: no touchscreen ({e})", file=sys.stderr, flush=True)
            for line in f:
                try:
                    m = json.loads(line)
                except ValueError:
                    continue
                if m.get("t") == "key":
                    child.stdin.write(b"key\n"); child.stdin.flush()
                elif touch[0] and m.get("t") in ("d", "m", "u"):
                    touch[0].event(m["t"], int(m.get("i", 0)), float(m.get("x", 0)), float(m.get("y", 0)))
        except (OSError, ValueError):
            pass
        finally:
            if touch[0]:
                touch[0].release_all()
            if child:
                child.kill(); child.wait()
            conn.close()

    while True:
        conn, _a = srv.accept()
        if current[0]:
            try:
                current[0].shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
        current[0] = conn
        threading.Thread(target=session, args=(conn,), daemon=True).start()


def adb_reverse_loop():
    """Keeps `adb reverse tcp:<port>` on every USB-connected phone (the dashboard reaches the PC through it)."""
    while True:
        try:
            port = mirror_conf(conf())[1]
            out = subprocess.run(["adb", "devices"], capture_output=True, text=True, timeout=10).stdout
            for serial in [l.split()[0] for l in out.splitlines()[1:] if l.strip().endswith("device")]:
                have = subprocess.run(["adb", "-s", serial, "reverse", "--list"], capture_output=True, text=True, timeout=10).stdout
                if f"tcp:{port} tcp:{port}" not in have:
                    subprocess.run(["adb", "-s", serial, "reverse", f"tcp:{port}", f"tcp:{port}"], capture_output=True, timeout=10)
        except (OSError, subprocess.SubprocessError):
            pass
        time.sleep(15)


def run():
    def goodbye(signum, frame):
        # Service stopped or PC shutting down: tell the phone right away (photo frame without the 90 s wait).
        try:
            req(conf(), "POST", "/cmd", {"pc": "offline"}, timeout=3)
        except Exception:
            pass
        sys.exit(0)

    threading.Thread(target=lambda: _safe(serve_pull), daemon=True).start()
    threading.Thread(target=lambda: _safe(serve_mirror), daemon=True).start()
    threading.Thread(target=adb_reverse_loop, daemon=True).start()
    signal.signal(signal.SIGTERM, goodbye)
    signal.signal(signal.SIGINT, goodbye)
    photo_thread, last_photo = None, 0.0
    last_sent, last_lock = 0.0, None
    while True:
        try:
            locked = pc_locked()
            if time.time() - last_sent >= 30 or locked != last_lock:
                c = conf()
                req(c, "POST", "/state", state_payload(c))
                last_sent, last_lock = time.time(), locked
                if time.time() - last_photo > 600 and not (photo_thread and photo_thread.is_alive()):
                    last_photo = time.time()
                    photo_thread = threading.Thread(target=lambda: _safe(sync_photos, c), daemon=True)
                    photo_thread.start()
        except (OSError, urllib.error.URLError, ValueError) as e:
            print(f"phone unreachable: {e}", file=sys.stderr, flush=True)
            last_sent = time.time()  # retry at the normal pace
        time.sleep(3)


def _safe(fn, *a):
    try:
        fn(*a)
    except Exception as e:
        print(f"{getattr(fn, '__name__', 'task')}: {e}", file=sys.stderr, flush=True)


def pair():
    """Reads the phone's API token over USB (adb) and stores it in ~/.config/phone-dash/token."""
    attempts = [["adb", "shell", "cat", f"/sdcard/Android/data/{PKG}/files/token"],   # release builds
                ["adb", "shell", "run-as", PKG, "cat", "files/token"]]                  # debug builds
    tok, err = "", ""
    for cmd in attempts:
        out = subprocess.run(cmd, capture_output=True, text=True)
        tok, err = out.stdout.strip(), out.stderr.strip()
        if out.returncode == 0 and len(tok) >= 32:
            break
    else:
        sys.exit(f"Could not read the token (is the app installed and opened once?): {err or tok}")
    CONF_DIR.mkdir(parents=True, exist_ok=True)
    TOKEN.write_text(tok + "\n")
    TOKEN.chmod(0o600)
    conf()
    print(f"Token saved to {TOKEN}")


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__); return
    cmd, args = argv[0], argv[1:]
    if cmd == "run": return run()
    if cmd == "pair": return pair()
    if cmd == "pair-launcher": return pair_launcher()
    if cmd == "_mirror-stream": return mirror_stream(args[0], int(args[1]), int(args[2]))
    c = conf()
    if cmd == "brightness" and args:
        v = None if args[0] == "auto" else int(args[0])
        print(req(c, "POST", "/cmd", {"brightness": v if v is not None else "auto"}))
    elif cmd == "screen" and args and args[0] in ("on", "off", "auto"):
        print(req(c, "POST", "/cmd", {"screen": args[0]}))
    elif cmd == "status":
        print(json.dumps(req(c, "GET", "/status"), indent=2))
    elif cmd == "sync-photos":
        sync_photos(c, verbose=True)
    elif cmd == "schedule":
        s = c.get("screen", {})
        print(json.dumps({"brightness": [[k, int(v)] for k, v in sorted(c.get("brightness", {}).items())],
                          "night": s.get("night", []), "off": s.get("off", [])}))
    elif cmd == "layout":
        l = c.get("layout", {})
        print(json.dumps({"tabs": l.get("tabs", ALL_TABS), "all": ALL_TABS,
                          "show_billable": l.get("show_billable", True), "show_notes": l.get("show_notes", True)}))
    elif cmd == "set-layout" and args:
        d = json.loads(args[0])
        tabs = [t for t in d.get("tabs", []) if t in ALL_TABS]
        if not tabs:
            sys.exit("At least one visible tab is required")
        c["layout"] = {"tabs": list(dict.fromkeys(tabs)), "show_billable": bool(d.get("show_billable", True)),
                       "show_notes": bool(d.get("show_notes", True))}
        write_conf(c)
        push(c)
        print("ok")
    elif cmd == "notes":
        print(json.dumps(c.get("notes", {}).get("items", [])))
    elif cmd == "set-notes" and args:
        items = [str(x).strip()[:200] for x in json.loads(args[0]) if str(x).strip()][:6]
        c.setdefault("notes", {})["items"] = items
        write_conf(c)
        push(c)
        print("ok")
    elif cmd == "options":
        sc, pl = c.get("screen", {}), c.get("player", {})
        print(json.dumps({"lyrics": pl.get("lyrics", True), "light": sc.get("light_sensor", True),
                          "on_lock": sc.get("on_lock", "frame"),
                          "slideshow": int(c.get("slideshow", {}).get("seconds", 20)),
                          "language": c.get("language", "it")}))
    elif cmd == "option" and args:
        name, value = args[0], (args[1] if len(args) > 1 else None)
        where = {"lyrics": ("player", "lyrics"), "light": ("screen", "light_sensor"), "on_lock": ("screen", "on_lock"),
                 "slideshow": ("slideshow", "seconds"), "language": (None, "language")}
        if name not in where:
            sys.exit("Options: " + ", ".join(where))
        sec, key = where[name]
        if name == "language":
            if value is not None:
                if value not in ("it", "en"):
                    sys.exit("language: it, en")
                c["language"] = value
                write_conf(c)
                push(c)
            print(c.get("language", "it"))
            return
        if value is not None:
            if name == "slideshow":
                if not value.isdigit() or not 3 <= int(value) <= 3600:
                    sys.exit("slideshow: seconds between 3 and 3600")
                c.setdefault(sec, {})[key] = int(value)
            elif name == "on_lock":
                if value not in ("frame", "off", "none"):
                    sys.exit("on_lock: frame, off, none")
                c.setdefault(sec, {})[key] = value
            else:
                c.setdefault(sec, {})[key] = value in ("on", "true", "1", "yes")
            write_conf(c)
            push(c)
        v = c.get(sec, {}).get(key, {"on_lock": "frame", "slideshow": 20}.get(name, True))
        print(v if isinstance(v, (str, int)) and not isinstance(v, bool) else ("on" if v else "off"))
    elif cmd == "animation":
        if args:
            if args[0] not in ANIM_MODES:
                sys.exit("Allowed values: " + ", ".join(ANIM_MODES))
            c.setdefault("player", {})["animation"] = args[0]
            write_conf(c)
            try:
                req(c, "POST", "/state", state_payload(c))
            except Exception:
                pass
        print(c.get("player", {}).get("animation", "30s"))
    elif cmd == "set-schedule" and args:
        set_schedule(c, args[0])
    elif cmd == "mirror" and args and args[0] in ("full", "tab", "off", "toggle"):
        if len(args) > 1:
            c.setdefault("mirror", {})["output"] = args[1]
            write_conf(c)
        mode = args[0]
        if mode == "toggle":  # for a keybinding: full screen <-> back to the dashboard
            mode = "off" if req(c, "GET", "/status").get("mirror") == "full" else "full"
        print(req(c, "POST", "/cmd", {"mirror": mode}))
    elif cmd == "google-token" and args:
        print(req(c, "POST", "/cmd", {"oauth_token": args[0]}, timeout=30))
    else:
        print(__doc__); sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
